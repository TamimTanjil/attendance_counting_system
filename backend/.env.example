# Camera source: RTSP URL, http MJPEG URL, a video file, or "0" for a webcam
CAMERA_SOURCE=0
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...)
DATABASE_URL=sqlite:///./attendance.db
# Where enrolment photos are stored
MEDIA_DIR=./media
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,https://attendance-countingsyster.lovable.app
